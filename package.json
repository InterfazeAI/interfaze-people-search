{
  "name": "interfaze-people-search",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "serve out --listen tcp://127.0.0.1:3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "node scripts/live-check.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@chakra-ui/react": "3.34.0",
    "@emotion/react": "11.14.0",
    "lucide-react": "1.70.0",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.6.2",
    "serve": "14.2.7",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "description": "Discover experts through papers and patents, with inspectable source evidence. Powered only by Interfaze."
}
